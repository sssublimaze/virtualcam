def main():
    parser = argparse.ArgumentParser(
        description="VirtualCam - Câmera virtual universal",
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument("-d", "--dir", help="Pasta com vídeos")
    parser.add_argument("-v", "--video", help="Arquivo de vídeo específico")
    parser.add_argument("-r", "--resolution", help="Resolução WxH (ex: 1920x1080)")
    parser.add_argument("--fps", type=int, help="FPS (1-120)")
    parser.add_argument("--loop", action="store_true", default=None, help="Repetir vídeo")
    parser.add_argument("--no-loop", action="store_false", dest="loop", help="Não repetir")
    parser.add_argument("--shuffle", action="store_true", help="Modo aleatório")
    parser.add_argument("--overlay", help="Texto de overlay na tela")
    parser.add_argument("--cli", action="store_true", help="Modo CLI (sem menus)")
    parser.add_argument("--list", action="store_true", help="Listar vídeos e sair")
    parser.add_argument("--devices", action="store_true", help="Listar dispositivos de vídeo")
    args = parser.parse_args()

    cfg = Config.load()

    if args.dir:
        cfg.video_dir = args.dir
    if args.resolution:
        parts = args.resolution.lower().split("x")
        if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
            cfg.width, cfg.height = int(parts[0]), int(parts[1])
    if args.fps:
        cfg.fps = max(1, min(args.fps, 120))
    if args.loop is not None:
        cfg.loop = args.loop
    if args.shuffle:
        cfg.shuffle = True
    if args.overlay:
        cfg.overlay_text = args.overlay

    if args.list:
        videos = scan_videos(cfg.video_dir)
        if not videos:
            print("Nenhum vídeo encontrado.")
            return
        for v in videos:
            print(v)
        return

    if args.devices:
        if IS_LINUX:
            subprocess.run(["v4l2-ctl", "--list-devices"], check=False)
        else:
            subprocess.run(["ffmpeg", "-list_devices", "true", "-f", "dshow", "-i", "dummy"],
                           stderr=subprocess.STDOUT, check=False)
        return

    # ── Interactive setup ──
    print_banner()

    videos = scan_videos(cfg.video_dir)
    if not videos:
        err(f"Nenhum vídeo em: {C.BOLD}{cfg.video_dir}{C.NC}")
        if pick_folder_gui(cfg):
            videos = scan_videos(cfg.video_dir)
        if not videos:
            err("Nenhum vídeo disponível. Encerrando.")
            sys.exit(1)

    selected = None
    if args.video:
        vp = Path(args.video)
        if vp.is_file():
            selected = vp
        else:
            err(f"Arquivo não encontrado: {args.video}")

    if not selected and not args.cli:
        pick_resolution(cfg)
        pick_fps(cfg)

        section("Selecionar vídeo", C.BLUE)
        ok(f"Pasta: {C.BOLD}{cfg.video_dir}{C.NC}")
        selected = list_videos_menu(videos)
        if not selected:
            err("Nenhum vídeo selecionado.")
            sys.exit(1)

        ok(f"Vídeo: {C.BOLD}{selected.name}{C.NC}")
        hr()

        if len(videos) > 1:
            ask("Modo playlist? [s/N/seq/rand]:")
            try:
                pm = input().strip().lower()
                if pm in ("s", "sim", "seq", "random", "rand", "playlist"):
                    if pm in ("rand", "random"):
                        cfg.shuffle = True
                        random.shuffle(videos)
                    cfg.loop = True
            except (EOFError, KeyboardInterrupt):
                pass

    if not selected:
        selected = videos[0] if not args.cli else (videos[0] if videos else None)
        if not selected:
            err("Nenhum vídeo selecionado.")
            sys.exit(1)

    cfg.save()

    # ── Backend ──
    if IS_LINUX:
        backend = LinuxV4L2Backend(cfg)
    else:
        backend = WindowsBackend(cfg)

    # ── Start stream ──
    print()
    section("Transmitindo", C.GREEN)
    print()
    print(f"  {C.PURPLE}▶{C.NC}  Arquivo:    {C.BOLD}{C.WHITE}{selected.name}{C.NC}")
    print(f"  {C.YELLOW}⚙{C.NC}  Resolução:  {C.BOLD}{cfg.width}×{cfg.height}{C.NC}")
    print(f"  {C.GREEN}◉{C.NC}  Dispositivo: {C.BOLD}{cfg.device}{C.NC}")
    print(f"  {C.CYAN}◎{C.NC}  FPS:        {C.BOLD}{cfg.fps}{C.NC}")
    print(f"  {C.DIM}  Loop: {'sim' if cfg.loop else 'não'},  Shuffle: {'sim' if cfg.shuffle else 'não'}{C.NC}")
    print()
    ok("Câmera virtual ativa!")

    keys = f"{C.BOLD}T{C.NC}rocar"
    keys += f"  │  {C.BOLD}N{C.NC}ext" if cfg.shuffle else ""
    keys += f"  │  {C.BOLD}L{C.NC}oop  │  {C.BOLD}P{C.NC}asta  │  {C.BOLD}F{C.NC}PS  │  {C.BOLD}R{C.NC}es  │  {C.BOLD}Q{C.NC}uit"
    status_activate(keys)

    playlist = list(videos)
    if cfg.shuffle:
        random.shuffle(playlist)
    pl_idx = playlist.index(selected) if selected in playlist else 0

    current_video = selected
    backend.start(current_video)

    # ── Hotkey dispatcher ──
    # Estas funções rodam NA MAIN THREAD, onde input() funciona.
    hk = HotkeyListener()

    def cmd_change_video():
        nonlocal current_video, pl_idx
        hk.pause_term()
        videos_refresh = scan_videos(cfg.video_dir)
        if not videos_refresh:
            hk.resume_term(); warn("Nenhum vídeo disponível"); return
        if cfg.shuffle:
            next_v = random.choice(videos_refresh)
        else:
            clear(); print_banner()
            section("Trocar vídeo", C.YELLOW)
            nv = list_videos_menu(videos_refresh)
            next_v = nv if nv else None
        hk.resume_term()
        if next_v is None:
            return
        current_video = next_v
        ok(f"Trocando para: {C.BOLD}{current_video.name}{C.NC}")
        time.sleep(0.3)
        backend.restart(current_video)

    def cmd_next_video():
        nonlocal current_video, pl_idx
        videos_refresh = scan_videos(cfg.video_dir)
        if not videos_refresh:
            return
        current_video = random.choice(videos_refresh) if cfg.shuffle \
            else videos_refresh[(pl_idx + 1) % len(videos_refresh)]
        ok(f"Próximo: {C.BOLD}{current_video.name}{C.NC}")
        backend.restart(current_video)

    def cmd_toggle_loop():
        cfg.loop = not cfg.loop
        cfg.save()
        ok(f"Loop: {'ativado' if cfg.loop else 'desativado'}")

    def cmd_pick_folder():
        nonlocal playlist
        hk.pause_term()
        clear(); print_banner()
        if pick_folder_gui(cfg):
            videos_refresh = scan_videos(cfg.video_dir)
            if videos_refresh:
                playlist = list(videos_refresh)
                if cfg.shuffle:
                    random.shuffle(playlist)
                info("Pasta alterada. Pressione T para escolher vídeo.")
        hk.resume_term()

    def cmd_pick_res():
        hk.pause_term()
        clear(); print_banner()
        pick_resolution(cfg)
        hk.resume_term()
        info("Resolução alterada. Troque o vídeo (T) para aplicar.")

    def cmd_pick_fps():
        hk.pause_term()
        clear(); print_banner()
        pick_fps(cfg)
        hk.resume_term()
        info("FPS alterado. Troque o vídeo (T) para aplicar.")

    def cmd_quit():
        _exit_flag.set()
        hk.stop()
        backend.stop()
        print()
        print(f"  {C.YELLOW}╔══════════════════════════════════════════╗{C.NC}")
        print(f"  {C.YELLOW}║{C.NC}  {C.PURPLE}▶{C.NC}     VirtualCam encerrado.             {C.YELLOW}║{C.NC}")
        print(f"  {C.YELLOW}╚══════════════════════════════════════════╝{C.NC}")
        print()
        os._exit(0)

    hotkey_map = {
        "t": cmd_change_video,
        "n": cmd_next_video,
        "l": cmd_toggle_loop,
        "p": cmd_pick_folder,
        "r": cmd_pick_res,
        "f": cmd_pick_fps,
        "q": cmd_quit,
    }

    def cleanup(*_):
        _exit_flag.set()
        hk.stop()
        backend.stop()
        os._exit(0)
    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    hk.start()

    # ── Main loop (processa queue + monitora backend) ──
    try:
        while not _exit_flag.is_set():
            # processa hotkeys
            try:
                while True:
                    key = hk.queue.get_nowait()
                    handler = hotkey_map.get(key)
                    if handler:
                        handler()
            except queue.Empty:
                pass

            # monitora backend
            if not backend.alive:
                if cfg.loop:
                    videos_refresh = scan_videos(cfg.video_dir)
                    if videos_refresh:
                        current_video = random.choice(videos_refresh) if cfg.shuffle \
                            else videos_refresh[(pl_idx + 1) % len(videos_refresh)]
                        ok(f"Auto-avanço: {C.BOLD}{current_video.name}{C.NC}")
                        backend.restart(current_video)
                else:
                    err("Stream encerrado.")
                    break

            _exit_flag.wait(0.3)
    except KeyboardInterrupt:
        cleanup()


if __name__ == "__main__":
    main()
