def open_folder_dialog(title="Escolha a pasta com seus vídeos", initialdir=None):
    try:
        import tkinter as tk
        from tkinter import filedialog
        root = tk.Tk()
        root.withdraw()
        root.attributes("-topmost", True)
        folder = filedialog.askdirectory(title=title, initialdir=initialdir)
        root.destroy()
        return folder if folder else None
    except Exception:
        return None


def scan_videos(directory):
    videos = []
    d = Path(directory)
    if not d.is_dir():
        return videos
    for ext in VIDEO_EXTS:
        videos.extend(d.glob(f"*{ext}"))
        videos.extend(d.glob(f"*{ext.upper()}"))
    videos.sort(key=lambda p: p.name.lower())
    return videos

# ────────────────────────────────────────────────────────
# FFMPEG FRAME PIPE (used by Windows backend)
# ────────────────────────────────────────────────────────
def ffmpeg_pipe_cmd(video, width, height, fps, loop, overlay_text, overlay_pos):
    vf = f"scale={width}:{height}:force_original_aspect_ratio=decrease,pad={width}:{height}:(ow-iw)/2:(oh-ih)/2,format=rgb24"
    if overlay_text:
        pos_map = {"top": "10:10", "bottom": "10:H-30", "center": "(W-text_w)/2:(H-text_h)/2"}
        pos = pos_map.get(overlay_pos, "10:H-30")
        vf += f",drawtext=text='{overlay_text}':fontcolor=white:fontsize=24:x={pos.split(':')[0]}:y={pos.split(':')[1]}"
    return [
        "ffmpeg", "-stream_loop", "-1" if loop else "1",
        "-re", "-i", str(video), "-vf", vf,
        "-r", str(fps), "-pix_fmt", "rgb24",
        "-f", "rawvideo", "-", "-loglevel", "warning",
    ]


class VirtualCamBackend:
    def __init__(self, cfg):
        self.cfg = cfg
        self.proc = None

    def start(self, video): ...
    def restart(self, video): return self.start(video)

    def stop(self):
        if self.proc:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.proc.kill()
            self.proc = None

    @property
    def alive(self):
        return self.proc is not None and self.proc.poll() is None


class LinuxV4L2Backend(VirtualCamBackend):
    def __init__(self, cfg):
        super().__init__(cfg)
        self._setup_device()

    def _devnum(self, path):
        m = re.search(r"(\d+)$", path)
        return m.group(1) if m else "2"

    def _setup_device(self):
        section("Configurando câmera virtual", C.BLUE)
        info("Carregando v4l2loopback...")
        devnum = self._devnum(self.cfg.device)
        subprocess.run(["sudo", "modprobe", "-r", "v4l2loopback"], capture_output=True)
        subprocess.run([
            "sudo", "modprobe", "v4l2loopback",
            f"video_nr={devnum}",
            f"card_label={self.cfg.card_label}",
            "exclusive_caps=1",
        ])
        ok(f"Dispositivo: {C.BOLD}{self.cfg.device}{C.NC}")
        hr()

    def _build_cmd(self, video):
        w, h = self.cfg.width, self.cfg.height
        vf = f"scale={w}:{h}:force_original_aspect_ratio=decrease,pad={w}:{h}:(ow-iw)/2:(oh-ih)/2,format=yuv420p"
        if self.cfg.overlay_text:
            pos_map = {"top": "10:10", "bottom": "10:H-30", "center": "(W-text_w)/2:(H-text_h)/2"}
            pos = pos_map.get(self.cfg.overlay_pos, "10:H-30")
            vf += f",drawtext=text='{self.cfg.overlay_text}':fontcolor=white:fontsize=24:x={pos.split(':')[0]}:y={pos.split(':')[1]}"
        return [
            "ffmpeg", "-stream_loop", "-1" if self.cfg.loop else "1",
            "-re", "-i", str(video), "-vf", vf,
            "-r", str(self.cfg.fps), "-pix_fmt", "yuv420p",
            "-f", "v4l2", self.cfg.device, "-loglevel", "warning",
        ]

    def start(self, video):
        self.stop()
        self.proc = subprocess.Popen(self._build_cmd(video))
        return True


class WindowsBackend(VirtualCamBackend):
    def __init__(self, cfg):
        super().__init__(cfg)
        self.strategy = None
        self.pipe_proc = None
        self.send_thread = None
        self._detect_backend()

    def _detect_backend(self):
        print()
        section("Detectando backend", C.YELLOW)

        try:
            import softcam
            self.strategy = "softcam"
            ok(f"softcam {C.DIM}(MIT, nativo, sem OBS){C.NC}")
            hr(); return
        except ImportError:
            pass

        try:
            import pyvirtualcam
            import winreg
            try:
                k = winreg.OpenKey(winreg.HKEY_CLASSES_ROOT,
                    "CLSID\\{3D07E3F2-4A0A-48E0-9BD6-37F6CCF8A657}")
                k.Close()
                self.strategy = "pyvcam"
                self.pyvcam_backend = "unitycapture"
                ok(f"Unity Capture + pyvirtualcam {C.DIM}(MIT, sem OBS){C.NC}")
                hr(); return
            except OSError:
                pass
            self.strategy = "pyvcam"
            self.pyvcam_backend = "obs"
            warn("OBS Virtual Camera detectado (fallback)")
            hr(); return
        except ImportError:
            pass

        self.strategy = None
        warn("Nenhum backend de câmera virtual encontrado")
        dim("  Opções recomendadas (sem OBS Studio):")
        dim(f"    {C.BOLD}1){C.NC} pip install softcam  {C.DIM}+ driver softcam{C.NC}")
        dim(f"    {C.BOLD}2){C.NC} pip install pyvirtualcam + registrar Unity Capture")
        hr()

    def _ffmpeg_cmd(self, video):
        return ffmpeg_pipe_cmd(
            video, self.cfg.width, self.cfg.height, self.cfg.fps,
            self.cfg.loop, self.cfg.overlay_text, self.cfg.overlay_pos,
        )

    def start(self, video):
        self.stop()
        return {
            "softcam": self._start_softcam,
            "pyvcam": self._start_pyvcam,
        }.get(self.strategy, self._start_fallback)(video)

    def _start_softcam(self, video):
        import numpy as np
        from softcam import camera
        w, h = self.cfg.width, self.cfg.height
        self.pipe_proc = subprocess.Popen(
            self._ffmpeg_cmd(video), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        fsize = w * h * 3

        def _run():
            try:
                cam = camera(w, h, self.cfg.fps)
                cam.wait_for_connection()
                ok(f"softcam: app conectado em {C.BOLD}{self.cfg.card_label}{C.NC}")
                while self.pipe_proc and self.pipe_proc.poll() is None:
                    raw = self.pipe_proc.stdout.read(fsize)
                    if len(raw) < fsize:
                        break
                    cam.send_frame(np.frombuffer(raw, dtype=np.uint8).reshape((h, w, 3)))
            except Exception as e:
                err(f"softcam: {e}")

        self.send_thread = threading.Thread(target=_run, daemon=True)
        self.send_thread.start()
        self.proc = self.pipe_proc
        return True

    def _start_pyvcam(self, video):
        import numpy as np
        import pyvirtualcam
        w, h = self.cfg.width, self.cfg.height
        self.pipe_proc = subprocess.Popen(
            self._ffmpeg_cmd(video), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        fsize = w * h * 3

        def _run():
            try:
                with pyvirtualcam.Camera(
                    width=w, height=h, fps=self.cfg.fps,
                    backend=self.pyvcam_backend, device=self.cfg.card_label,
                ) as cam:
                    while self.pipe_proc and self.pipe_proc.poll() is None:
                        raw = self.pipe_proc.stdout.read(fsize)
                        if len(raw) < fsize:
                            break
                        cam.send(np.frombuffer(raw, dtype=np.uint8).reshape((h, w, 3)))
                        cam.sleep_until_next_frame()
            except Exception as e:
                err(f"pyvirtualcam: {e}")

        self.send_thread = threading.Thread(target=_run, daemon=True)
        self.send_thread.start()
        self.proc = self.pipe_proc
        return True

    def _start_fallback(self, video):
        warn("Modo preview: exibindo vídeo em janela (sem câmera virtual)")
        self.proc = subprocess.Popen([
            "ffplay", "-window_title", self.cfg.card_label,
            "-x", str(self.cfg.width), "-y", str(self.cfg.height), str(video)])
        return True

    def stop(self):
        if self.pipe_proc:
            try:
                self.pipe_proc.terminate()
                self.pipe_proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.pipe_proc.kill()
            self.pipe_proc = None
        super().stop()

    def restart(self, video):
        return self.start(video)



_exit_flag = threading.Event()

class HotkeyListener:
    """Lê teclas na thread e envia para a queue. A main thread processa."""

    def __init__(self):
        self.queue = queue.Queue()
        self._running = True
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._old_term = None
        self._fd = None
        self._pause_request = threading.Event()
        self._paused = threading.Event()

    def start(self):
        self._thread.start()

    def stop(self):
        self._running = False
        self._restore_term()

    def pause_term(self):
        """Restaura terminal para cooked mode (para usar input())."""
        self._restore_term()

    def resume_term(self):
        """Re-entra em cbreak mode."""
        if not IS_WIN:
            try:
                self._setup_term()
            except Exception:
                pass

    def _restore_term(self):
        if self._old_term is not None and self._fd is not None:
            import termios
            try:
                termios.tcsetattr(self._fd, termios.TCSANOW, self._old_term)
            except Exception:
                pass

    def _setup_term(self):
        import termios, tty
        self._fd = sys.stdin.fileno()
        self._old_term = termios.tcgetattr(self._fd)
        tty.setcbreak(self._fd)

    def _run(self):
        if IS_WIN:
            self._run_windows()
        else:
            self._run_unix()

    def _run_unix(self):
        import select
        try:
            self._setup_term()
        except Exception:
            pass
        try:
            while self._running and not _exit_flag.is_set():
                r, _, _ = select.select([sys.stdin], [], [], 0.3)
                if r:
                    key = sys.stdin.read(1).lower()
                    self.queue.put(key)
        finally:
            self._restore_term()

    def _run_windows(self):
        import msvcrt
        while self._running and not _exit_flag.is_set():
            if msvcrt.kbhit():
                key = msvcrt.getch().decode("utf-8", errors="replace").lower()
                self.queue.put(key)
            else:
                _exit_flag.wait(0.1)



def pick_folder_gui(cfg):
    """Abre explorador gráfico. Fallback para input() se tkinter falhar."""
    print()
    section("Selecionar pasta de vídeos", C.BLUE)
    dim(f"Pasta atual: {C.BOLD}{cfg.video_dir}{C.NC}")
    print()
    folder = open_folder_dialog(initialdir=cfg.video_dir)
    if folder:
        cfg.video_dir = folder
        ok(f"Pasta: {C.BOLD}{cfg.video_dir}{C.NC}")
        cfg.save()
        hr()
        return True
    # fallback textual
    warn("Diálogo gráfico cancelado/falhou. Digite o caminho manualmente:")
    ask("Caminho da pasta:")
    try:
        inp = input().strip().strip('"').strip("'")
        if inp:
            p = Path(inp).expanduser()
            if p.is_dir():
                cfg.video_dir = str(p.resolve())
                ok(f"Pasta: {C.BOLD}{cfg.video_dir}{C.NC}")
                cfg.save()
                hr()
                return True
            err("Pasta inválida")
    except (EOFError, KeyboardInterrupt):
        pass
    hr()
    return False


def pick_resolution(cfg):
    print()
    section("Resolução da câmera", C.YELLOW)
    presets = [
        ("640×480  SD", 640, 480),
        ("720×1280 Vertical HD", 720, 1280),
        ("1080×1920 Vertical Full HD", 1080, 1920),
        ("1280×720  Horizontal HD", 1280, 720),
        ("1920×1080 Full HD", 1920, 1080),
        ("3840×2160 4K UHD", 3840, 2160),
    ]
    print()
    for i, (label, *_ ) in enumerate(presets, 1):
        marker = " ●" if (presets[i-1][1], presets[i-1][2]) == (cfg.width, cfg.height) else ""
        print(f"  {C.BOLD}{C.WHITE}{i}{C.NC}  {label:<25}{C.DIM}{marker}{C.NC}")
    print()
    ask(f"Opção [1-{len(presets)}, Enter=manter, ou WxH custom]:")
    try:
        inp = input().strip()
        if inp:
            parts = inp.lower().split("x")
            if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
                cfg.width, cfg.height = int(parts[0]), int(parts[1])
            else:
                idx = int(inp) - 1
                if 0 <= idx < len(presets):
                    cfg.width, cfg.height = presets[idx][1], presets[idx][2]
    except (ValueError, EOFError, KeyboardInterrupt):
        pass
    ok(f"Resolução: {C.BOLD}{cfg.width}×{cfg.height}{C.NC}")
    cfg.save()
    hr()


def pick_fps(cfg):
    section("FPS da câmera", C.YELLOW)
    ask(f"FPS [Enter={cfg.fps}]:")
    try:
        inp = input().strip()
        if inp and inp.isdigit():
            cfg.fps = max(1, min(int(inp), 120))
    except (EOFError, KeyboardInterrupt):
        pass
    ok(f"FPS: {C.BOLD}{cfg.fps}{C.NC}")
    cfg.save()
    hr()


def list_videos_menu(videos):
    if not videos:
        err("Nenhum vídeo encontrado")
        return None
    print()
    for i, v in enumerate(videos, 1):
        size = v.stat().st_size
        s = f"{size / 1024 / 1024:.1f}MB" if size > 1024 * 1024 else f"{size / 1024:.0f}KB"
        print(f"  {C.BOLD}{C.WHITE}{i:2d}{C.NC}  {v.name:<50} {C.DIM}{s}{C.NC}")
    print()
    ask(f"Número [1-{len(videos)}, r=aleatório, Enter=1]:")
    try:
        inp = input().strip().lower()
        if inp == "r":
            return random.choice(videos)
        if inp:
            idx = int(inp) - 1
            if 0 <= idx < len(videos):
                return videos[idx]
    except (ValueError, EOFError, KeyboardInterrupt):
        pass
    return videos[0]


