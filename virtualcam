@dataclass
class Config:
    video_dir: str = str(Path.home() / "Videos")
    device: str = "/dev/video2" if IS_LINUX else "VirtualCam"
    card_label: str = "VirtualCam"
    width: int = 720
    height: int = 1280
    fps: int = 30
    loop: bool = True
    shuffle: bool = False
    volume: float = 0.0
    overlay_text: str = ""
    overlay_pos: str = "bottom"

    def save(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(json.dumps(asdict(self), indent=2))

    @classmethod
    def load(cls) -> Config:
        if CONFIG_FILE.exists():
            try:
                return cls(**json.loads(CONFIG_FILE.read_text()))
            except Exception:
                pass
        return cls()



_STATUS_ACTIVE = False
_STATUS_FOOTER = ""
_STATUS_LINES = 3  # blank + separator + hotkeys

def _status_redraw():
    global _STATUS_ACTIVE, _STATUS_FOOTER
    if _STATUS_ACTIVE:
        print(f"\n{C.DIM}────────────────────────────────────────────────────{C.NC}")
        print(f"  {C.BOLD}{C.WHITE}⌨{C.NC}  {C.DIM}Comandos:{C.NC}  {_STATUS_FOOTER}")
        print(end="", flush=True)

def status_activate(footer):
    global _STATUS_ACTIVE, _STATUS_FOOTER
    _STATUS_FOOTER = footer
    _STATUS_ACTIVE = True
    _status_redraw()

def status_deactivate():
    global _STATUS_ACTIVE
    _STATUS_ACTIVE = False

def _status_msg(icon, color, msg):
    if _STATUS_ACTIVE:
        print(f"\r\033[{_STATUS_LINES}A\033[J  {color}{icon}{C.NC}  {msg}")
        _status_redraw()
    else:
        print(f"  {color}{icon}{C.NC}  {msg}")

def info(msg):  _status_msg("ℹ", C.CYAN, msg)
def ok(msg):    _status_msg("✔", C.GREEN, msg)
def err(msg):   _status_msg("✘", C.RED, msg)
def warn(msg):  _status_msg("⚠", C.YELLOW, msg)

def ask(msg):
    print(f"  {C.CYAN}?{C.NC}  {msg}", end=" ", flush=True)

def dim(msg):
    print(f"  {C.DIM}{msg}{C.NC}")

def hr():
